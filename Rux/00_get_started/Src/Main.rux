import Std::Io::{PrintLine, ReadLine};
import Std::Format;

func Main() -> int {
    PrintLine("Hello, world!");
    PrintLine("Factorial calculation");
    let n = 5;
    var result = 1;
    for i in 1..=n {
        result *= i;
        PrintLine("{}! = {}", i, result);
    }

    PrintLine("Enter a word");
    let userInput = ReadLine();
    PrintLine(Format("You typed: {}", userInput));
    return 0;
}